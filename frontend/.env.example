# ──────────────────────────────────────────────────────
# GrievAI Frontend Environment Variables
# Copy this file to .env and fill in your keys
# ──────────────────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:4000

# Google Gemini API Key (for chatbot & priority AI)
# Get from: https://aistudio.google.com/app/apikeys
VITE_GEMINI_API_KEY=

# ── ElevenLabs Conversational AI ──────────────────────
# Get your Agent ID from: https://elevenlabs.io/app/conversational-ai
# Create a new agent → copy the Agent ID
VITE_ELEVENLABS_AGENT_ID=

# Note: For PUBLIC agents, only the Agent ID is needed (no API key required in frontend).
# For PRIVATE agents requiring signed URLs, you'll need a backend endpoint.
